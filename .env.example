# Fusion-Multi-Node docker-compose 环境变量模板。
# 用法: cp .env.example .env && 填强随机值, 再 docker compose up -d。
# P2-23 (审计 §6.10): compose 不带弱默认, 未设则启动失败并提示 (见 docker-compose.yml ${VAR:?...})。
# .env 不要提交 git (已在 .gitignore); .env.example 提交模板不含真实凭据。

# ── 基础 (必填) ──

# 集群共享密钥 — master 与所有 agent 必须一致 (auth.py Bearer token)。
# 生成强随机值: python -c "import secrets; print(secrets.token_urlsafe(32))"
FUSION_CLUSTER_TOKEN=change-me-to-strong-random-token

# fusion-mlx 推理引擎 api_key (与 fusion-mlx 启用的鉴权 key 一致)。
FUSION_MLX_API_KEY=change-me-to-mlx-api-key

# 推理引擎地址 — 裸机跑则用 host.docker.internal:11434 (Docker Desktop 内置)。
FUSION_MLX_URL=http://host.docker.internal:11434

# 单 agent 并发任务上限 — 压测时调高以充分利用 MLX 后端并发。
FUSION_AGENT_MAX_TASKS=4

# ── 资源上限 (P2-13 审计 §6.11) ──
# 默认 4GB/4核 (Apple Silicon M 系), 压测/大模型可调高。
# mem_limit/cpus 同时用于 compose v2 字段 + deploy.resources.limits (v3 spec)。
FUSION_MASTER_MEM_LIMIT=4g
FUSION_MASTER_CPUS=4
FUSION_AGENT_MEM_LIMIT=4g
FUSION_AGENT_CPUS=4

# ── v0.14.0 企业生产 (可选, 默认关/空=回退 config.json + 文件) ──
# 详见 docs/DEPLOYMENT.md。env 优先于 config.json; 空串视同未设 (不覆盖 config 段)。

# mTLS 节点互信 (生产必配) — 开启后集群内 HTTP 双向证书认证, 拒绝非集群节点。
# 1. 生成集群 CA: python -c "from fusion_multi_node.security.mtls import provision_cluster; print(provision_cluster())"
# 2. 各节点签叶证书: provision_node(node_id, role, ca.crt, ca.key, ip=...) (带 SAN 防 MITM)
# 3. 证书文件挂载进容器 (volumes), 路径填下方 env。
# fail-closed: 开启但证书路径不全 → 启动 raise, 不回退明文 (GAP-2)。
# 注意: docker-compose --scale agent=N 时各 agent 共享同 env → 同 node_id → 证书冲突;
#       多 agent mTLS 须用独立 compose 文件或 entrypoint 生成各节点叶证书 (见 DEPLOYMENT.md)。
# FUSION_MTLS_ENABLED=1
# FUSION_MTLS_CA_CERT=/tls/ca.crt
# FUSION_MTLS_NODE_CERT=/tls/node.crt
# FUSION_MTLS_NODE_KEY=/tls/node.key
# FUSION_MTLS_NODE_ID=master-1
# FUSION_MTLS_NODE_ROLE=master

# 告警出站 webhook (生产必配) — 节点掉线/内存/持久化告警推内网端点 (100% 本地, 无云依赖)。
# 空=仅内存 deque, 须轮询 GET /api/v1/observability/alerts。
# FUSION_ALERT_WEBHOOK_URL=http://内网告警端点/alert

# 多租户首启引导 ADMIN (GAP-8 F1) — 首次启动自动创建 ADMIN 用户并签发首令牌 (明文仅日志一次)。
# 空=单租户零配置向后兼容 (纯集群令牌, 无用户库)。
# FUSION_BOOTSTRAP_ADMIN=admin

# 用户库路径覆盖 — 默认 ~/.fusion/multi-node/users.json。
# FUSION_USERS_FILE=/data/fusion-multi-node/users.json
